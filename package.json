{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && vite build --ssr src/entry-prerender.tsx --outDir build/prerender && tsx scripts/prerender-seo.ts && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=build/server.cjs",
    "start": "node build/server.cjs",
    "preview": "vite preview",
    "test": "node run_tests.js",
    "test-only": "tsx --test test/*.test.ts",
    "clean": "rm -rf dist build",
    "indexnow": "tsx scripts/indexnow.ts",
    "e2e": "playwright test",
    "qa:accounts": "tsx scripts/qa/create-accounts.ts",
    "qa:session": "tsx scripts/qa/session.ts",
    "qa:purge": "tsx scripts/qa/purge.ts"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "@google/genai": "^2.4.0",
    "@heroui/react": "^3.2.6",
    "@heroui/styles": "^3.2.6",
    "@mediapipe/tasks-vision": "0.10.17",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@rive-app/react-canvas-lite": "^4.40.0",
    "@supabase/supabase-js": "^2.116.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/luxon": "^3.7.5",
    "@vercel/analytics": "^1.6.1",
    "@vercel/functions": "3.9.11",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "gsap": "^3.15.0",
    "lottie-react": "^3.1.2",
    "lucide-react": "^0.546.0",
    "luxon": "^3.7.2",
    "motion": "^12.23.24",
    "pdfjs-dist": "6.5.438",
    "react": "^19.0.1",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.3",
    "three": "^0.186.1",
    "vite": "^6.2.3",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
