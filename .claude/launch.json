{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "prod",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "-e",
        "process.env.NODE_ENV='production';require('./build/server.cjs')"
      ],
      "port": 3000
    }
  ]
}