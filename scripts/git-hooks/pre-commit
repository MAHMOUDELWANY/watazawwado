#!/bin/sh
# Enforced for every agent and person committing in this clone (Claude's hooks only run inside Claude Code).
# Enable once per clone: git config core.hooksPath scripts/git-hooks
fail=0

# Existing migrations may already be applied in production: only new files are allowed.
changed=$(git diff --cached --name-status --diff-filter=MDR -- 'supabase/migrations/*.sql')
if [ -n "$changed" ]; then
  echo "Blocked: existing migrations are append-only. Add a new migration file instead:" >&2
  echo "$changed" >&2
  fail=1
fi

# Secrets never enter git.
envs=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '(^|/)\.env[^/]*$' | grep -v '\.env\.example$')
if [ -n "$envs" ]; then
  echo "Blocked: secret files must not be committed:" >&2
  echo "$envs" >&2
  fail=1
fi

exit $fail
