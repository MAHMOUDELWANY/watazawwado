# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Configuration
# VITE_SUPABASE_URL: Your Supabase Project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL="https://your-project.supabase.co"

# VITE_SUPABASE_ANON_KEY: Client-safe Supabase Anonymous Key (safe for browser with RLS)
VITE_SUPABASE_ANON_KEY="your-anon-key"

# SUPABASE_SERVICE_ROLE_KEY: Server-only elevated key for background workers / admin tasks
# Never expose this to the browser client.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Google Calendar Integration (OAuth 2.0)
# GOOGLE_CLIENT_ID: Client ID from Google Cloud Console (Calendar API enabled)
GOOGLE_CLIENT_ID=""

# GOOGLE_CLIENT_SECRET: Client Secret from Google Cloud Console
GOOGLE_CLIENT_SECRET=""

# GOOGLE_REDIRECT_URI: Optional custom redirect URI (defaults to APP_URL + /api/integrations/google-calendar/callback)
GOOGLE_REDIRECT_URI=""

# Zoom Integration (Server-to-Server OAuth & Room Management)
# ZOOM_ACCOUNT_ID: Zoom Account ID from Zoom Marketplace Server-to-Server OAuth App
ZOOM_ACCOUNT_ID=""

# ZOOM_CLIENT_ID: Zoom OAuth Client ID
ZOOM_CLIENT_ID=""

# ZOOM_CLIENT_SECRET: Zoom OAuth Client Secret
ZOOM_CLIENT_SECRET=""

# ====================================================================
# Brevo Transactional Email Engine (Production & Transactional Layer)
# ====================================================================
# BREVO_API_KEY: Server-only API key from Brevo dashboard (SMTP & API -> API Keys)
# Free tier supports 300 transactional emails per day.
# Required in production to deliver lesson confirmations, reminders, and alerts.
BREVO_API_KEY=""

# Sender Identity Configuration
# NOTIFICATION_FROM_EMAIL: The verified sender email in your Brevo account (e.g. mahmoudelwany98@gmail.com)
NOTIFICATION_FROM_EMAIL="mahmoudelwany98@gmail.com"

# NOTIFICATION_FROM_NAME: The friendly sender name displayed in email clients
NOTIFICATION_FROM_NAME="Mahmoud Elwany"

# NOTIFICATION_REPLY_TO_EMAIL: Reply-To address for students replying to automated notifications
NOTIFICATION_REPLY_TO_EMAIL="mahmoudelwany98@gmail.com"

# NOTIFICATION_TEACHER_EMAIL: Recipient email where Mahmoud receives internal alerts & booking notices
NOTIFICATION_TEACHER_EMAIL="mahmoudelwany98@gmail.com"

# Cron Security
# CRON_SECRET: Bearer token or query parameter to secure /api/cron/process-reminders
CRON_SECRET=""
